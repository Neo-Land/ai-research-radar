# Copy to .env and fill in. Never commit .env.

# Writer: the model that writes briefs. LLM_PROVIDER is "claude" or "gemini".
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Gemini alternative (free tier, ~20 requests per model per day)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Judge: the model that fact-checks briefs in src/evaluate_briefs.py
JUDGE_PROVIDER=claude
JUDGE_MODEL=claude-opus-5-5

# Writer prompt: v1 (original) or v2 (with faithfulness rules)
PROMPT_VERSION=v2
